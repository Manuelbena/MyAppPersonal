<?xml version="1.0" encoding="utf-8"?>
<!--
  Icono de Syncro: anillo de sincronización (dos flechas, por la sync con Google) con un check en
  el centro (tareas hechas). Todo cabe en la zona segura del icono adaptativo (círculo de 66dp en
  el centro del lienzo de 108dp), así que ninguna forma de máscara lo recorta.
  Se usa también como icono monocromo (Android 13+): ahí solo cuenta la forma, no el color.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Arco superior con su flecha (sentido horario) -->
    <path
        android:pathData="M32.75,48.31 A22,22 0 0,1 72.02,41.38"
        android:strokeColor="#FF22D3EE"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M73.82,35.24 L73.74,43.84 L65.62,40.98"
        android:strokeColor="#FF22D3EE"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- Arco inferior con su flecha: el mismo girado 180° -->
    <path
        android:pathData="M75.25,59.69 A22,22 0 0,1 35.98,66.62"
        android:strokeColor="#FF22D3EE"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M34.18,72.76 L34.26,64.16 L42.38,67.02"
        android:strokeColor="#FF22D3EE"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- Check central -->
    <path
        android:pathData="M44.5,54.5 L51,61 L63.5,47.5"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>
