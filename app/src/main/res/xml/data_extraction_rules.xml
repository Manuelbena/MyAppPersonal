<?xml version="1.0" encoding="utf-8"?>
<!--
   Copia de seguridad y traspaso entre móviles (Android 12+). Todo entra salvo los ajustes de la app:
   así, al reinstalar o empezar de cero, la guía de inicio vuelve a salir.
   Mantener igual que backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/app_settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/app_settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
